    "#load test data and predict admission chances\n",
    "data = pd.read_csv(\"testData.csv\", usecols=['GRE Score','TOEFL Score','University Rating','SOP','LOR','CGPA','Research'])\n",
    "temp = data.values\n",
    "data = data.values\n",
    "data = scaler.transform(data)#normalzie test data\n",
    "data = np.reshape(data, (data.shape[0], data.shape[1], 1, 1))#reshape test data\n",
    "predict = cnn_model.predict(data)#apply cnn to predict admission chance\n",
    "predict = predict.reshape(-1, 1)\n",
    "predict = scaler1.inverse_transform(predict)\n",
    "for i in range(len(predict)):\n",
    "    print(\"Test Data = \"+str(temp[i])+\" Predicted Chance of Admission ===> \"+str(predict[i,0]*100)+\"%\")"
   ]
