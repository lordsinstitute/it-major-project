    "#showing all algorithms with scenario A and B performance values\n",
    "columns = [\"Algorithm Name\",\"MSE\",\"R2 Score\"]\n",
    "values = []\n",
    "algorithm_names = [\"CNN\", \"SVM\", \"Decision Tree\", \"Random Forest\",\"Linear Regression\", \"KNN\"]\n",
    "for i in range(len(algorithm_names)):\n",
    "    values.append([algorithm_names[i],mse[i],r2scores[i]])\n",
    "\n",
    "temp = pd.DataFrame(values,columns=columns)\n",
    "temp"
