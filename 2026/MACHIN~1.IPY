   "source": [
    "#finding and displaying count of missing or null values\n",
    "dataset = pd.read_csv(\"Latest Admission Perdiction DS (1).csv\", usecols=['GRE Score','TOEFL Score','University Rating','SOP','LOR','CGPA','Research','Chance of Admit'])\n",
    "dataset.isnull().sum()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "ed53dbeb",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Normalized Features\n",
      "[[0.66666667 0.6        1.         ... 0.71428571 0.87401575 1.        ]\n",
      " [0.51111111 0.4        0.5        ... 0.42857143 0.53937008 1.        ]\n",
      " [0.8        0.8        1.         ... 0.42857143 0.87401575 0.        ]\n",
      " ...\n",
      " [0.06666667 0.52       0.5        ... 0.71428571 0.38188976 0.        ]\n",
      " [0.82222222 0.4        0.5        ... 1.         0.3976378  0.        ]\n",
      " [0.75555556 0.6        1.         ... 0.71428571 0.74015748 1.        ]]\n"
     ]
    }
   ],
   "source": [
    "#Extracting X training features and Y label\n",
    "Y = dataset['Chance of Admit'].ravel()\n",
    "Y = Y.reshape(-1, 1)\n",
    "dataset.drop(['Chance of Admit'], axis = 1,inplace=True)\n",
    "X = dataset.values\n",
    "#normalizing training features and labels\n",
    "scaler = MinMaxScaler(feature_range = (0, 1))\n",
    "scaler1 = MinMaxScaler(feature_range = (0, 1))\n",
    "X = scaler.fit_transform(X)#normalize train features\n",
    "Y = scaler1.fit_transform(Y)\n",
    "print(\"Normalized Features\")\n",
    "print(X)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "d3f75e30",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
